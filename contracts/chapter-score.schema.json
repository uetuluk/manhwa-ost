{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manhwa-ost.local/contracts/chapter-score.schema.json",
  "title": "ChapterScore",
  "description": "What the brain returns for one chapter: narrative sections and the cue each one asks for.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapter", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "page_count"],
      "properties": {
        "number": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "page_count": { "type": "integer", "minimum": 1 }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "start_page", "end_page", "label", "mood", "energy", "tension", "motif", "arrangement"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "start_page": { "type": "integer", "minimum": 1 },
        "end_page": { "type": "integer", "minimum": 1 },
        "label": {
          "type": "string",
          "maxLength": 60,
          "description": "Short human name for the beat, e.g. 'Ambush in the alley'."
        },
        "summary": {
          "type": "string",
          "maxLength": 300,
          "description": "One or two sentences of what happens, for the cue-sheet UI."
        },
        "mood": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": ["calm", "tense", "battle", "grief", "mystery", "triumph", "dread", "wonder", "comic", "romance"]
          }
        },
        "energy": { "type": "number", "minimum": 0, "maximum": 1 },
        "tension": { "type": "number", "minimum": 0, "maximum": 1 },
        "motif": {
          "type": "string",
          "description": "Leitmotif id from the series score book: main | ash | battle | grief | wonder."
        },
        "arrangement": {
          "type": "string",
          "maxLength": 200,
          "description": "Instrumentation/arrangement tags for this cue."
        },
        "transition_in": {
          "enum": ["cut", "crossfade", "swell"],
          "default": "crossfade"
        }
      }
    }
  }
}
